# ==========================================
# Gamispace - Environment Variables (Example)
# ==========================================
# Instructions: Make a copy of this file, rename it to '.env', 
# and replace the example values with your actual credentials.

# --- API Configuration (Backend) ---
PORT=5000
# Generate a long, random string to sign tokens 
JWT_SECRET=your_super_secure_and_long_jwt_secret_here

# --- Routing and Connection URLs ---
# Public URL where the Frontend is served (React/Nginx)
URL_FRONTEND=http://localhost:3000

# API URL consumed by the client (Vite will inject this during the build process)
VITE_SERVER_URL=http://localhost:5000

# API URL consumed internally by the server
URL_BACKEND=http://localhost:5000

# --- Database Configuration (MySQL) ---
# Application user credentials
DB_USER=gamiuser
DB_PASSWORD=secure_user_password_here
DB_NAME=gamiespace

# MySQL administrative credential (only needed when initializing the container)
DB_ROOT_PASSWORD=secure_root_password_here
